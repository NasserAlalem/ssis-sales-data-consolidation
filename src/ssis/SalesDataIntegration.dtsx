                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">(DT_DBDATE)([LEN]([TRIM]((DT_WSTR,20)#{Package\Data Flow Task\Flat File Source.Outputs[Flat File Source Output].Columns[Date]})) == 7 ? ([SUBSTRING]("0" + [TRIM]((DT_WSTR,20)#{Package\Data Flow Task\Flat File Source.Outputs[Flat File Source Output].Columns[Date]}),5,4) + "-" + [SUBSTRING]("0" + [TRIM]((DT_WSTR,20)#{Package\Data Flow Task\Flat File Source.Outputs[Flat File Source Output].Columns[Date]}),3,2) + "-" + [SUBSTRING]("0" + [TRIM]((DT_WSTR,20)#{Package\Data Flow Task\Flat File Source.Outputs[Flat File Source Output].Columns[Date]}),1,2)) : ([SUBSTRING]([TRIM]((DT_WSTR,20)#{Package\Data Flow Task\Flat File Source.Outputs[Flat File Source Output].Columns[Date]}),5,4) + "-" + [SUBSTRING]([TRIM]((DT_WSTR,20)#{Package\Data Flow Task\Flat File Source.Outputs[Flat File Source Output].Columns[Date]}),3,2) + "-" + [SUBSTRING]([TRIM]((DT_WSTR,20)#{Package\Data Flow Task\Flat File Source.Outputs[Flat File Source Output].Columns[Date]}),1,2)))</property>
